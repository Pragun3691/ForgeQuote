{
  "name": "forgequote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm start --workspace apps/api",
    "test": "npm test --workspace apps/api",
    "test:db": "npm run test:db --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:seed-users": "npm run db:seed-users --workspace apps/api",
    "test:browser": "node tests/browser-auth.smoke.js",
    "test:browser:quotation": "node tests/browser-quotation.smoke.js",
    "test:browser:rfq": "node tests/browser-rfq.smoke.js",
    "test:browser:ai": "node tests/browser-ai.smoke.js",
    "test:ai:live": "npm run test:ai:live --workspace apps/api",
    "db:check-permissions": "npm run db:check-permissions --workspace apps/api",
    "db:grant-runtime": "npm run db:grant-runtime --workspace apps/api",
    "db:prepare-cloud": "npm run db:prepare-cloud --workspace apps/api",
    "db:check-cloud-permissions": "npm run db:check-cloud-permissions --workspace apps/api",
    "check:api": "npm run check --workspace apps/api",
    "test:production": "npm run test:production --workspace apps/api",
    "test:costing": "npm run test:costing --workspace apps/api",
    "test:browser:xlsx": "node tests/browser-xlsx.smoke.js",
    "test:browser:ai:association": "node tests/browser-ai-association.smoke.js",
    "test:browser:ai:live": "node tests/browser-ai-association.smoke.js --live",
    "test:browser:lifecycle": "node tests/browser-lifecycle.smoke.js",
    "test:browser:pdf": "node tests/browser-pdf.smoke.js",
    "test:browser:rates-ux": "node tests/browser-rates-ux.smoke.js"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "playwright": "^1.64.1"
  }
}
